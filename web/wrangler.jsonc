{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "os-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "studio.os.shivanshsethi.in",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
